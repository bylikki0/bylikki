model Order {
  id String @id @default(uuid(7))

  reference String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  contactEmail String

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  subtotalCents Int
  shippingCents Int    @default(0)
  totalCents    Int
  currency      String @default("EUR")

  discountId    String?
  discount      Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountCode  String?
  discountLabel String?
  discountCents Int       @default(0)

  discountRedemption DiscountRedemption?

  shippingFullName   String
  shippingLine1      String
  shippingLine2      String?
  shippingPostalCode String
  shippingCity       String
  shippingCountry    String  @default("FR")

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  trackingNumber String?

  invoiceNumber Int?      @unique
  invoicedAt    DateTime?

  needsAttention  Boolean @default(false)
  attentionReason String?

  items   OrderItem[]
  returns ReturnRequest[]

  reviewReminderSentAt DateTime?

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([needsAttention])
}

model Counter {
  name  String @id
  value Int    @default(0)
}

model OrderItem {
  id String @id @default(uuid(7))

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productSlug    String
  productName    String
  variantLabel   String
  unitPriceCents Int
  quantity       Int
  totalCents     Int

  customization Json?

  returnItems ReturnRequestItem[]

  customDesignId String?
  customDesign   CustomDesign? @relation(fields: [customDesignId], references: [id], onDelete: SetNull)

  stockTaken Int @default(0)

  @@index([orderId])
  @@index([productId])
}
